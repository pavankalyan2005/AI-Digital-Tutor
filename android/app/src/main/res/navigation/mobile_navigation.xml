<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.aidigitaltutor.app.ui.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_learning"
        android:name="com.aidigitaltutor.app.ui.LearningFragment"
        android:label="Learning"
        tools:layout="@layout/fragment_learning" />

    <fragment
        android:id="@+id/navigation_chat"
        android:name="com.aidigitaltutor.app.ui.ChatFragment"
        android:label="AI Tutor"
        tools:layout="@layout/fragment_chat" />

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.aidigitaltutor.app.ui.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile" />
</navigation>
